<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="jwt_token_refresh">
  <description>PHP CodeSniffer configuration for the JWT Token Refresh module.</description>

  <!-- Include all rules in the Drupal ruleset. -->
  <rule ref="Drupal"/>

  <!-- DrupalPractice is optional on drupal.org, but this module is clean
       against it. Enforcing it keeps that true instead of letting it rot. -->
  <rule ref="DrupalPractice"/>

  <!-- Keep the extensions in alphabetic order like Core. -->
  <arg name="extensions" value="engine,inc,info,install,module,php,profile,test,theme,yml"/>

</ruleset>
